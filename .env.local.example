# soluXYZon World Clock — environment variables
#
# Copy this file to .env.local and fill in your Supabase project credentials.
# Get these from: https://supabase.com/dashboard → your project → Settings → API
#
# IMPORTANT: NEXT_PUBLIC_* vars are shipped to the browser. Only put the ANON
# public key here — NEVER the service_role key.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...your-anon-public-key...
